{
  "name": "unlock-build-survive",
  "version": "0.1.0",
  "private": true,
  "description": "A kid-friendly 3D structural engineering game: build toy buildings on a floating island and test them against natural disasters.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "lint": "oxlint --type-aware --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint:fix": "oxlint --type-aware --fix",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
