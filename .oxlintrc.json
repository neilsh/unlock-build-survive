{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc",
    "vitest",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "restriction": "off",
    "style": "off"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["dist", "node_modules"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "eqeqeq": "error",
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "import/no-cycle": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "max-statements": "off",
    "max-classes-per-file": "off",
    "no-magic-numbers": "off",
    "id-length": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "unicorn/prefer-query-selector": "off",
    "typescript/consistent-return": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["__GAME_DEBUG__"]
      }
    ],
    "react-perf/jsx-no-jsx-as-prop": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "Engine code must not import React; bridge via src/state/store.ts."
              }
            ],
            "patterns": [
              { "group": ["**/components/**"], "message": "Engine code must not import UI components." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "three", "message": "UI code must not import three.js; call GameActions instead." },
              { "name": "@dimforge/rapier3d-compat", "message": "UI code must not import Rapier." }
            ],
            "patterns": [
              { "group": ["three/**"], "message": "UI code must not import three.js." },
              {
                "group": ["**/engine/**"],
                "message": "UI code must not import engine code; use GameActions."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/types/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "three", "message": "Pure types/data must not import three.js." },
              { "name": "react", "message": "Pure types/data must not import React." },
              { "name": "@dimforge/rapier3d-compat", "message": "Pure types/data must not import Rapier." }
            ],
            "patterns": [
              { "group": ["three/**"], "message": "Pure types/data must not import three.js." },
              { "group": ["**/engine/**"], "message": "Pure types/data must not import engine code." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/engine/PhysicsSim.ts", "src/engine/physics/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "window", "message": "Physics must run headless in Node." },
          { "name": "document", "message": "Physics must run headless in Node." }
        ]
      }
    }
  ],
  "options": {
    "typeAware": true
  }
}
