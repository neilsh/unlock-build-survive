{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "react-perf",
    "jsx-a11y",
    "import",
    "unicorn",
    "oxc",
    "vitest",
    "promise"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "restriction": "off",
    "style": "off"
  },
  "env": {
    "browser": true,
    "es2022": true
  },
  "ignorePatterns": ["dist", "coverage", "node_modules", "playwright-report", "test-results"],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "eqeqeq": "error",
    "no-console": [
      "error",
      {
        "allow": ["warn", "error"]
      }
    ],
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "no-await-in-loop": "error",
    "no-constant-binary-expression": "error",
    "no-promise-executor-return": "error",
    "no-async-promise-executor": "error",
    "no-unmodified-loop-condition": "error",
    "no-unreachable-loop": "error",
    "no-useless-catch": "error",
    "no-template-curly-in-string": "error",
    "no-self-compare": "error",
    "array-callback-return": "error",
    "no-caller": "error",
    "no-eval": "error",
    "no-implied-eval": "error",
    "no-new-wrappers": "error",
    "no-throw-literal": "error",
    "no-return-assign": "error",
    "no-sequences": "error",
    "no-lone-blocks": "error",
    "no-loss-of-precision": "error",
    "no-extend-native": "error",
    "default-case-last": "error",
    "no-useless-concat": "error",
    "no-useless-escape": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/prefer-as-const": "error",
    "typescript/no-empty-object-type": "error",
    "import/no-cycle": "error",
    "import/no-self-import": "error",
    "import/no-duplicates": "error",
    "import/no-named-default": "error",
    "promise/catch-or-return": "error",
    "promise/no-return-wrap": "error",
    "promise/no-nesting": "error",
    "promise/no-callback-in-promise": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/jsx-key": "error",
    "react/no-array-index-key": "error",
    "react/jsx-no-target-blank": "error",
    "react/no-danger": "error",
    "react/jsx-no-useless-fragment": "error",
    "react/no-unstable-nested-components": "error",
    "react/void-dom-elements-no-children": "error",
    "react/jsx-no-duplicate-props": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/no-autofocus": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/throw-new-error": "error",
    "unicorn/prefer-array-some": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/no-thenable": "error",
    "unicorn/prefer-spread": "error",
    "unicorn/no-useless-undefined": "error",
    "vitest/no-identical-title": "error",
    "vitest/valid-expect": "error",
    "vitest/valid-title": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-disabled-tests": "error",
    "oxc/no-accumulating-spread": "error",
    "oxc/bad-array-method-on-arguments": "error",
    "oxc/no-map-spread": "error",
    "oxc/no-const-enum": "error",
    "react-perf/jsx-no-new-object-as-prop": "off",
    "react-perf/jsx-no-new-function-as-prop": "off",
    "max-lines-per-function": "off",
    "max-lines": "off",
    "max-statements": "off",
    "max-classes-per-file": "off",
    "no-magic-numbers": "off",
    "id-length": "off",
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "unicorn/prefer-query-selector": "off",
    "typescript/consistent-return": "off",
    "no-underscore-dangle": [
      "error",
      {
        "allow": ["__GAME_DEBUG__"]
      }
    ],
    "react-perf/jsx-no-jsx-as-prop": "off",
    "jsx-a11y/prefer-tag-over-role": "off"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "e2e/**"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off"
      }
    },
    {
      "files": ["src/engine/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "message": "Engine code must not import React; bridge via src/state/store.ts."
              }
            ],
            "patterns": [
              { "group": ["**/components/**"], "message": "Engine code must not import UI components." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/components/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "three", "message": "UI code must not import three.js; call GameActions instead." },
              { "name": "@dimforge/rapier3d-compat", "message": "UI code must not import Rapier." }
            ],
            "patterns": [
              { "group": ["three/**"], "message": "UI code must not import three.js." },
              {
                "group": ["**/engine/**"],
                "message": "UI code must not import engine code; use GameActions."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/types/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              { "name": "three", "message": "Pure types/data must not import three.js." },
              { "name": "react", "message": "Pure types/data must not import React." },
              { "name": "@dimforge/rapier3d-compat", "message": "Pure types/data must not import Rapier." }
            ],
            "patterns": [
              { "group": ["three/**"], "message": "Pure types/data must not import three.js." },
              { "group": ["**/engine/**"], "message": "Pure types/data must not import engine code." }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/engine/PhysicsSim.ts", "src/engine/physics/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          { "name": "window", "message": "Physics must run headless in Node." },
          { "name": "document", "message": "Physics must run headless in Node." }
        ]
      }
    }
  ]
}
